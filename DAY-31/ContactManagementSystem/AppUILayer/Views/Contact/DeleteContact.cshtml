@model DataAccessLayer.Models.ContactInfo

@{
    ViewData["Title"] = "Delete Contact";
}

<h2>Delete Contact</h2>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this contact?</h4>
    <p>This action cannot be undone.</p>
</div>

<div class="card">
    <div class="card-header bg-danger text-white">
        <h4>@Model.FullName</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Contact ID</dt>
            <dd class="col-sm-9">@Model.ContactId</dd>

            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.EmailId</dd>

            <dt class="col-sm-3">Mobile</dt>
            <dd class="col-sm-9">@Model.MobileNo</dd>

            <dt class="col-sm-3">Designation</dt>
            <dd class="col-sm-9">@Model.Designation</dd>

            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@Model.Company?.CompanyName</dd>

            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@Model.Department?.DepartmentName</dd>
        </dl>
    </div>
</div>

<form asp-action="DeleteContact" method="post" class="mt-3">
    <input type="hidden" asp-for="ContactId" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="ShowContacts" class="btn btn-secondary">Cancel</a>
</form>