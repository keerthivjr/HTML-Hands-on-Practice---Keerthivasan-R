@model DataAccessLayer.Models.ContactInfo

@{
    ViewData["Title"] = "Contact Details";
}

<h1>👤 Contact Details</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Contact ID</dt>
            <dd class="col-sm-9">@Model.ContactId</dd>

            <dt class="col-sm-3">First Name</dt>
            <dd class="col-sm-9">@Model.FirstName</dd>

            <dt class="col-sm-3">Last Name</dt>
            <dd class="col-sm-9">@Model.LastName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.EmailId</dd>

            <dt class="col-sm-3">Mobile No</dt>
            <dd class="col-sm-9">@Model.MobileNo</dd>

            <dt class="col-sm-3">Designation</dt>
            <dd class="col-sm-9">@Model.Designation</dd>

            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@Model.Company?.CompanyName</dd>

            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@Model.Department?.DepartmentName</dd>
        </dl>

        <a href="@Url.Action("EditContact", new { id = Model.ContactId })" class="btn btn-warning">✏️ Edit</a>
        <a href="@Url.Action("ShowContacts")" class="btn btn-secondary">⬅️ Back to List</a>
    </div>
</div>