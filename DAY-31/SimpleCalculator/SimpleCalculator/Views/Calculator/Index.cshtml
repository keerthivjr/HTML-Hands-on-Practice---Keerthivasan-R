@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Simple Calculator</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 50px;
            background-color: #f0f0f0;
        }

        .container {
            width: 450px;
            padding: 30px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            margin: auto;
        }

        h2 {
            color: #333;
            text-align: center;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: inline-block;
            width: 100px;
            font-weight: bold;
            color: #555;
        }

        input {
            padding: 8px;
            width: 250px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
        }

        button {
            width: 100%;
            padding: 10px;
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
        }

            button:hover {
                background-color: #218838;
            }

        .result-box {
            margin-top: 20px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>🧮 Simple Calculator</h2>
        <h3 style="text-align:center; color:#666;">Addition Operation</h3>

        <form method="post" action="/Calculator/Add">
            <div class="form-group">
                <label>First Number:</label>
                <input type="number" name="num1" step="any" required placeholder="Enter first number" />
            </div>
            <div class="form-group">
                <label>Second Number:</label>
                <input type="number" name="num2" step="any" required placeholder="Enter second number" />
            </div>
            <button type="submit">➕ Add Numbers</button>
        </form>
    </div>
</body>
</html>