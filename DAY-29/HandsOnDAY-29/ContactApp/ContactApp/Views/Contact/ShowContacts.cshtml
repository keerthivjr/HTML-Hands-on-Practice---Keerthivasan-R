@model IEnumerable<ContactApp.Models.ContactInfo>

<h2 class="mt-3">Client Contact List</h2>

<div class="mb-3">
    <a asp-action="AddContact" class="btn btn-primary">Add New Contact</a>

    <button onclick="searchById()" class="btn btn-secondary">Search Contact</button>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Company</th>
            <th>Email</th>
            <th>Mobile</th>
            <th>Designation</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ContactId</td>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>@item.CompanyName</td>
                    <td>@item.EmailId</td>
                    <td>@item.MobileNo</td>
                    <td>@item.Designation</td>
                    <td>
                        <a asp-action="GetContactById" asp-route-id="@item.ContactId" class="btn btn-sm btn-info">Details</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No contacts found in the list.</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        function searchById() {
            // 1. Ask user for the ID
            var id = prompt("Enter Contact ID to search:");

            // 2. If user didn't hit cancel and entered a value
            if (id && id.trim() !== "") {
                // 3. Redirect to the GetContactById action in the Contact controller
                window.location.href = "/Contact/GetContactById/" + id;
            }
        }
    </script>
}