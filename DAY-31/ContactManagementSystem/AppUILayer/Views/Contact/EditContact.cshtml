@model DataAccessLayer.Models.ContactInfo

@{
    ViewData["Title"] = "Edit Contact";
    var companies = ViewBag.Companies as List<DataAccessLayer.Models.Company>;
    var departments = ViewBag.Departments as List<DataAccessLayer.Models.Department>;
}

<h2>Edit Contact</h2>

<form asp-action="EditContact" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="ContactId" />

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="EmailId" class="form-label"></label>
            <input asp-for="EmailId" class="form-control" type="email" />
            <span asp-validation-for="EmailId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="MobileNo" class="form-label"></label>
            <input asp-for="MobileNo" class="form-control" />
            <span asp-validation-for="MobileNo" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="Designation" class="form-label"></label>
            <input asp-for="Designation" class="form-control" />
            <span asp-validation-for="Designation" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CompanyId" class="form-label"></label>
            <select asp-for="CompanyId" class="form-control">
                <option value="">-- Select Company --</option>
                @foreach (var company in companies)
                {
                    if (company.CompanyId == Model.CompanyId)
                    {
                        <option value="@company.CompanyId" selected>@company.CompanyName</option>
                    }
                    else
                    {
                        <option value="@company.CompanyId">@company.CompanyName</option>
                    }
                }
            </select>
            <span asp-validation-for="CompanyId" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="DepartmentId" class="form-label"></label>
            <select asp-for="DepartmentId" class="form-control">
                <option value="">-- Select Department --</option>
                @foreach (var department in departments)
                {
                    if (department.DepartmentId == Model.DepartmentId)
                    {
                        <option value="@department.DepartmentId" selected>@department.DepartmentName</option>
                    }
                    else
                    {
                        <option value="@department.DepartmentId">@department.DepartmentName</option>
                    }
                }
            </select>
            <span asp-validation-for="DepartmentId" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <button type="submit" class="btn btn-primary">Update Contact</button>
            <a asp-action="ShowContacts" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}