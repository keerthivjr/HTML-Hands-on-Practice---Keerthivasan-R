@{
    Layout = null;
    string message = ViewData["Message"]?.ToString() ?? "";
    string messageType = ViewData["MessageType"]?.ToString() ?? "";
    string name = ViewData["Name"]?.ToString() ?? "";
    string comments = ViewData["Comments"]?.ToString() ?? "";
    int rating = ViewData["Rating"] != null ? Convert.ToInt32(ViewData["Rating"]) : 0;
}

<!DOCTYPE html>
<html>
<head>
    <title>Feedback Received</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 50px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }

        .container {
            max-width: 600px;
            margin: auto;
            background-color: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            text-align: center;
        }

        .success-message {
            background-color: #d4edda;
            color: #155724;
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
            border-left: 5px solid #28a745;
            animation: slideIn 0.5s ease;
        }

        .warning-message {
            background-color: #fff3cd;
            color: #856404;
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
            border-left: 5px solid #ffc107;
            animation: slideIn 0.5s ease;
        }
        /* Use double @@ to escape the @@ symbol in Razor */
        @@keyframes slideIn {
            from {
                transform: translateY(-20px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .feedback-details {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
            text-align: left;
        }

        .rating-display {
            font-size: 24px;
            margin: 10px 0;
        }

        button {
            padding: 12px 30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 20px;
            transition: transform 0.2s;
        }

            button:hover {
                transform: translateY(-2px);
            }

        .emoji {
            font-size: 50px;
            margin: 10px 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="emoji">
            @if (rating >= 4)
            {
                <span>🎉</span>
            }
            else
            {
                <span>💪</span>
            }
        </div>

        <h2>Feedback Received!</h2>

        <div class="@(messageType == "success" ? "success-message" : "warning-message")">
            <h3>@message</h3>
        </div>

        <div class="feedback-details">
            <h3>Your Feedback Summary:</h3>
            <p><strong>Name:</strong> @name</p>
            <p><strong>Comments:</strong> @comments</p>
            <p>
                <strong>Rating:</strong>
                <span class="rating-display">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= rating)
                        {
                            <span>⭐</span>
                        }
                        else
                        {
                            <span>☆</span>
                        }
                    }
                    (@rating/5)
                </span>
            </p>
        </div>

        <button onclick="location.href='/Feedback'">Submit Another Feedback</button>
    </div>
</body>
</html>