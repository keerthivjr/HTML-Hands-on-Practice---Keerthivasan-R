@model IEnumerable<DataAccessLayer.Models.ContactInfo>

@{
    ViewData["Title"] = "Contact List";
}

<h2>Contact Management System</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p>
    <a asp-action="AddContact" class="btn btn-primary">Add New Contact</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Mobile</th>
            <th>Designation</th>
            <th>Company</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ContactId</td>
                <td>@item.FullName</td>
                <td>@item.EmailId</td>
                <td>@item.MobileNo</td>
                <td>@item.Designation</td>
                <td>@item.Company?.CompanyName</td>
                <td>@item.Department?.DepartmentName</td>
                <td>
                    <a asp-action="GetContactById" asp-route-id="@item.ContactId" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="EditContact" asp-route-id="@item.ContactId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="DeleteContact" asp-route-id="@item.ContactId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No contacts found. Click "Add New Contact" to add your first contact.
    </div>
}