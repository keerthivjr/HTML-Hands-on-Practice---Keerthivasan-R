@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Student Registration</title>
    <style>
        body {
            font-family: Arial;
            margin: 50px;
        }

        .container {
            width: 400px;
            padding: 20px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: inline-block;
            width: 100px;
        }

        input {
            padding: 5px;
            width: 250px;
        }

        button {
            padding: 8px 20px;
            background-color: #007bff;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 3px;
        }

            button:hover {
                background-color: #0056b3;
            }
    </style>
</head>
<body>
    <div class="container">
        <h2>📝 Student Registration Form</h2>

        <form method="post">
            <div class="form-group">
                <label>Student Name:</label>
                <input type="text" name="studentName" required />
            </div>
            <div class="form-group">
                <label>Age:</label>
                <input type="number" name="age" required min="1" max="120" />
            </div>
            <div class="form-group">
                <label>Course:</label>
                <input type="text" name="course" required />
            </div>
            <button type="submit">Submit Registration</button>
        </form>
    </div>
</body>
</html>